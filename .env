# Application Information
APP_NAME=Vrm2SL
APP_NAME_KEBAB=vrm2sl
APP_DESCRIPTION=Convert VRM avatars to Second Life format with ease
APP_SUMMARY=VRM to Second Life converter desktop application

# Application Version (should match version in backend/Cargo.toml)
VERSION=0.8.3-alpha.3

# Author Information
AUTHOR_NAME=logue
AUTHOR_EMAIL=logue@hotmail.co.jp

# Tauri identifier (for tauri.conf.json)
TAURI_APP_IDENTIFIER=dev.logue.vrm2sl

# GitHub Repository
GITHUB_USER=logue
GITHUB_REPO=vrm2sl

# URLs
PROJECT_URL=https://github.com/logue/vrm2sl
HOMEPAGE_URL=https://logue.dev/vrm2sl
DOCS_URL=https://logue.dev/vrm2sl

# Vite exposed variables (public environment variables)
# Note: __APP_NAME__, __APP_VERSION__, __PROJECT_SITE__ are injected at build time via vite.config.ts define

# document site settings
NUXT_PUBLIC_SITE_URL=https://logue.dev/vrm2sl
NUXT_PUBLIC_SITE_NAME=Vrm2SL Documentation
NUXT_APP_BASE_URL=/vrm2sl/
GOOGLE_ANALYTICS_ID=UA-33600926-1

# Package Manager Settings
CHOCOLATEY_TAGS=VRM,SecondLife,Converter,DesktopApp
HOMEBREW_DESC=Convert VRM avatars to Second Life format with ease

# Docker Build Settings (optional)
# BUILD_CPUS=4
# BUILD_MEMORY=8g
# CARGO_BUILD_JOBS=4
# MAKEFLAGS=-j4
# INCLUDE_APPIMAGE=false
